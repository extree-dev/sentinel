<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Moderation Panel</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="light-theme">
    <div class="container">
        <header>
            <h1>Moderation Panel</h1>
            <div class="user-info">
                <div class="user-dropdown">
                    <div class="user-trigger" id="userDropdownTrigger"
                        style="display: flex; align-items: center; cursor: pointer;">
                        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png"
                            alt="User Avatar">
                        <span style="margin: 0 10px;">
                            <%= user.username %>
                        </span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <path d="M6 9l6 6 6-6"></path>
                        </svg>
                    </div>
                    <div class="user-dropdown-content" id="userDropdownContent">
                        <a href="#" class="user-dropdown-item" id="viewProfile">Мой профиль</a>
                        <a href="#" class="user-dropdown-item" id="serverMembers">Участники сервера</a>
                        <a href="#" class="user-dropdown-item" id="verificationRequestsBtn">
                            Заявки на верификацию
                            <span id="verificationCount" class="badge-verification"
                                style="display: inline-block">4</span>
                        </a>
                        <a href="/logout" class="user-dropdown-item">Выйти</a>
                    </div>
                </div>
                <button class="theme-toggle" id="themeToggle">Dark Mode</button>
            </div>
        </header>

        <div id="mainContent">

            <div class="online-users-section">
                <h2>Online Members</h2>
                <div class="online-users-container" id="onlineUsers" onclick="handleOnlineUserClick(event)">
                    <!-- Список будет заполняться через JavaScript -->
                    <div class="loading-spinner"></div>
                </div>
            </div>

            <div class="stats">
                <div class="stat-card">
                    <h3>Total Warnings</h3>
                    <p>
                        <%= warnings.length %>
                    </p>
                </div>
                <div class="stat-card">
                    <h3>Active Cases</h3>
                    <p>0</p>
                </div>
            </div>

            <div class="warnings-table">
                <h2>Recent Warnings</h2>
                <table>
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Reason</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% warnings.forEach(warning=> { %>
                            <tr>
                                <td>
                                    <img src="https://cdn.discordapp.com/avatars/<%= warning.userId %>/avatar.png"
                                        alt="User Avatar" class="user-avatar">
                                    <%= warning.username %>
                                </td>
                                <td>
                                    <%= warning.reason %>
                                </td>
                                <td>
                                    <%= warning.date %>
                                </td>
                                <td>
                                    <a href="/remove-warning/<%= warning.id %>" class="btn remove-btn">Remove</a>
                                </td>
                            </tr>
                            <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Модальное окно для списка пользователей -->
    <div id="membersModal" class="modal">
        <div class="modal-content">
            <span class="close-modal" id="closeMembersModal">&times;</span>
            <h2>Участники сервера</h2>
            <div class="user-list-container" id="userList">
                <!-- Список пользователей будет загружен здесь -->
            </div>
        </div>
    </div>

    <!-- Модальное окно для профиля пользователя -->
    <div id="profileModal" class="modal">
        <div class="modal-content">
            <span class="close-modal" id="closeProfileModal">&times;</span>
            <div id="profileContent">
                <!-- Контент профиля будет загружен здесь -->
            </div>
        </div>
    </div>

    <!-- Новое модальное окно для заявок на верификацию -->
    <div id="verificationModal" class="modal">
        <div class="modal-content" style="max-width: 800px;">
            <span class="close-modal" id="closeVerificationModal">&times;</span>
            <h2>Заявки на верификацию</h2>

            <div class="verification-tabs">
                <div class="verification-tab active" data-tab="pending">Ожидающие</div>
                <div class="verification-tab" data-tab="approved">Одобренные</div>
                <div class="verification-tab" data-tab="rejected">Отклоненные</div>
            </div>

            <div id="verificationRequests" class="verificationRequests">
                <!-- Список заявок будет заполняться через JavaScript -->
                <div class="loading-spinner"></div>
            </div>
        </div>
    </div>

    <script>

        function openModal(modalId) {
            document.getElementById(modalId).style.display = 'block';
        }

        function closeModal(modalId) {
            document.getElementById(modalId).style.display = 'none';
        }

        // Обработчики закрытия по крестику
        document.getElementById('closeMembersModal').addEventListener('click', function () {
            closeModal('membersModal');
        });

        document.getElementById('closeProfileModal').addEventListener('click', function () {
            closeModal('profileModal');
        });

        // Закрытие при клике вне окна
        window.addEventListener('click', function (event) {
            if (event.target.classList.contains('modal')) {
                closeModal(event.target.id);
            }
        });

        // Переключение темы
        const themeToggle = document.getElementById('themeToggle');
        const body = document.body;

        // Проверяем сохраненную тему
        const currentTheme = localStorage.getItem('theme') || 'light';
        body.classList.add(currentTheme + '-theme');
        updateButtonText();

        themeToggle.addEventListener('click', () => {
            // Добавляем класс для анимации
            body.classList.add('theme-transition');

            if (body.classList.contains('light-theme')) {
                body.classList.replace('light-theme', 'dark-theme');
                localStorage.setItem('theme', 'dark');
            } else {
                body.classList.replace('dark-theme', 'light-theme');
                localStorage.setItem('theme', 'light');
            }

            updateButtonText();

            // Удаляем класс после анимации
            setTimeout(() => {
                body.classList.remove('theme-transition');
            }, 600);
        });

        function updateButtonText() {
            themeToggle.textContent = body.classList.contains('dark-theme') ? 'Light Mode' : 'Dark Mode';
        }

        // Обработка выпадающего меню
        document.getElementById('serverMembers').addEventListener('click', async (e) => {
            e.preventDefault();
            openModal('membersModal');

            try {
                const response = await fetch('/api/server-members');
                const members = await response.json();

                const userList = document.getElementById('userList');
                userList.innerHTML = '';

                members.forEach(member => {
                    const userItem = document.createElement('div');
                    userItem.className = 'user-list-item';
                    userItem.dataset.userId = member.id;
                    userItem.innerHTML = `
                        <img src="${member.avatar ? `https://cdn.discordapp.com/avatars/${member.id}/${member.avatar}.png` : 'https://cdn.discordapp.com/embed/avatars/0.png'}" alt="${member.username}">
                        <span>${member.username}#${member.discriminator}</span>
                    `;
                    userList.appendChild(userItem);
                });
            } catch (error) {
                console.error('Error loading members:', error);
                alert('Не удалось загрузить список участников');
            }
        });

        // Обработчик клика по пользователю в списке
        document.addEventListener('click', async (e) => {
            if (e.target.closest('.user-list-item')) {
                const userId = e.target.closest('.user-list-item').dataset.userId;
                await showUserProfile(userId);
            }
        });


        // Добавляем кнопку в выпадающее меню
        const dropdownContent = document.querySelector('.user-dropdown-content');
        if (dropdownContent && !document.getElementById('verificationRequestsBtn')) {
            dropdownContent.insertAdjacentHTML('beforeend', `
        <a href="#" class="user-dropdown-item" id="verificationRequestsBtn">
            Заявки на верификацию
            <span id="verificationCount" class="badge-verification" style="display: inline-block">0</span>
        </a>
    `);
        }

        // Обработчик для кнопки заявок на верификацию
        document.getElementById('verificationRequestsBtn').addEventListener('click', async (e) => {
            e.preventDefault();
            openModal('verificationModal');
            loadVerificationRequests('pending');
        });

        // Обработчики для табов
        document.querySelectorAll('.verification-tab').forEach(tab => {
            tab.addEventListener('click', function () {
                document.querySelectorAll('.verification-tab').forEach(t => t.classList.remove('active'));
                this.classList.add('active');
                loadVerificationRequests(this.dataset.tab);
            });
        });

        async function updateVerificationCount() {
            const counter = document.getElementById('verificationCount');
            if (!counter) return;

            try {
                const response = await fetch('/api/verification-requests/count');

                // Добавляем проверку ответа
                if (!response.ok) throw new Error('Server error');

                const data = await response.json();
                counter.textContent = data.total || '0'; // Всегда показываем цифру
                counter.style.display = 'inline-block'; // Гарантируем видимость

            } catch (error) {
                console.error('Ошибка загрузки:', error);
                counter.textContent = '0'; // Всегда показываем 0 вместо !
                counter.style.opacity = '0.7'; // Полупрозрачный если ошибка
            }
        }

        // Загружаем счетчик при открытии страницы
        document.addEventListener('DOMContentLoaded', () => {
            updateVerificationCount();

            // Проверяем видимость элемента
            const checkVisibility = () => {
                const badge = document.getElementById('verificationCount');
                if (badge) {
                    console.log('Бейдж существует:', badge);
                    console.log('Стили:', window.getComputedStyle(badge));
                }
            };
            setTimeout(checkVisibility, 1000);
        });

        // Обновляем счетчик при клике на кнопку заявок
        document.getElementById('verificationRequestsBtn').addEventListener('click', function (e) {
            e.preventDefault();
            openModal('verificationModal');
            loadVerificationRequests('pending'); // Ваш существующий код загрузки заявок
        });

        // Обновляем счетчик после действий (одобрение/отклонение)
        function approveRequest(requestId) {
            // ... ваш код обработки заявки ...
            updateVerificationCount(); // Обновляем счетчик
        }

        // Функция загрузки заявок на верификацию
        async function loadVerificationRequests(status = 'pending') {
            try {
                const container = document.getElementById('verificationRequests');
                container.innerHTML = '<div class="loading-spinner"></div>';

                const response = await fetch(`/api/verification-requests?status=${status}`);
                const requests = await response.json();

                if (requests.length === 0) {
                    container.innerHTML = `<p class="no-requests">Нет заявок со статусом ${getStatusName(status)}</p>`;
                    return;
                }

                container.innerHTML = '';

                requests.forEach(request => {
                    const requestElement = document.createElement('div');
                    requestElement.className = 'verification-request';
                    requestElement.innerHTML = `
                        <div class="verification-request-header">
                            <div class="verification-request-user">
                                <img src="${request.user_avatar ?
                            `https://cdn.discordapp.com/avatars/${request.user_id}/${request.user_avatar}.png?size=32` :
                            'https://cdn.discordapp.com/embed/avatars/0.png'}" 
                                     alt="${request.user_name}" class="user-avatar-small">
                                <span>${request.user_name}</span>
                            </div>
                            <div class="verification-request-actions">
                                ${status === 'pending' ? `
                                <button class="btn approve-btn" onclick="processVerificationRequest('${request.id}', 'approve')">
                                    Одобрить
                                </button>
                                <button class="btn reject-btn" onclick="processVerificationRequest('${request.id}', 'reject')">
                                    Отклонить
                                </button>
                                ` : ''}
                            </div>
                        </div>
                        <div class="verification-request-content">
                            <p><strong>Дата подачи:</strong> ${new Date(request.created_at).toLocaleString()}</p>
                            <p><strong>Сообщение:</strong> ${request.message || 'Нет сообщения'}</p>
                            ${request.image_url ? `
                            <div>
                                <strong>Изображение:</strong>
                                <img src="${request.image_url}" class="verification-request-image" alt="Доказательство">
                            </div>
                            ` : ''}
                        </div>
                    `;
                    container.appendChild(requestElement);
                });
            } catch (error) {
                console.error('Error loading verification requests:', error);
                document.getElementById('verificationRequests').innerHTML = `
                    <div class="error-loading">
                        <i class="error-icon">!</i>
                        <p>Ошибка при загрузке заявок</p>
                        <button class="btn retry-btn" onclick="loadVerificationRequests('${status}')">
                            Попробовать снова
                        </button>
                    </div>
                `;
            }
        }

        function getStatusName(status) {
            const names = {
                'pending': 'ожидающие',
                'approved': 'одобренные',
                'rejected': 'отклоненные'
            };
            return names[status] || status;
        }

        // Функция обработки заявки (одобрение/отклонение)
        async function processVerificationRequest(requestId, action) {
            try {
                const response = await fetch(`/api/verification-requests/${requestId}`, {
                    method: 'PATCH',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ action })
                });

                if (response.ok) {
                    // Перезагружаем текущий список
                    const activeTab = document.querySelector('.verification-tab.active');
                    loadVerificationRequests(activeTab.dataset.tab);

                    // Показываем уведомление
                    alert(`Заявка успешно ${action === 'approve' ? 'одобрена' : 'отклонена'}`);
                } else {
                    throw new Error('Ошибка при обработке заявки');
                }
            } catch (error) {
                console.error('Error processing verification request:', error);
                alert('Не удалось обработать заявку');
            }
        }

        // Добавляем обработчик закрытия для нового модального окна
        document.getElementById('closeVerificationModal').addEventListener('click', function () {
            closeModal('verificationModal');
        });


        // Определяем цвета статусов
        const statusColors = {
            online: '#43b581',
            idle: '#faa61a',
            dnd: '#f04747',
            offline: '#747f8d'
        };

        const statusTexts = {
            online: 'Online',
            idle: 'Idle',
            dnd: 'Do Not Disturb',
            offline: 'Offline'
        };

        // Функция показа профиля пользователя
        async function showUserProfile(userId) {
            try {
                openModal('profileModal');

                // Показываем загрузку
                const profileContent = document.getElementById('profileContent');
                profileContent.innerHTML = `
            <div class="loading-profile">
                <div class="spinner"></div>
                <p>Загрузка профиля...</p>
            </div>
        `;

                // Добавляем таймаут для запроса
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 10000);

                const response = await fetch(`/api/user-profile/${userId}`, {
                    signal: controller.signal
                }).finally(() => clearTimeout(timeoutId));

                if (!response.ok) {
                    throw new Error(`Ошибка сервера: ${response.status}`);
                }

                const userData = await response.json();

                // Проверяем наличие основных данных
                if (!userData.id) {
                    throw new Error('Неполные данные профиля');
                }

                function formatAccountAge(creationDate) {
                    const now = new Date();
                    const diff = now - creationDate;
                    const days = Math.floor(diff / (1000 * 60 * 60 * 24));

                    if (days < 30) {
                        return `${days} ${days === 1 ? 'день' : days < 5 ? 'дня' : 'дней'} назад`;
                    }
                    return creationDate.toLocaleDateString('ru-RU', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                    });
                }

                function getCreationDate(userId) {
                    if (!userId || isNaN(parseInt(userId))) {
                        return null;
                    }
                    const discordEpoch = 1420070400000;
                    const timestamp = Math.floor(parseInt(userId) / 4194304) + discordEpoch;
                    return new Date(timestamp);
                }

                // Форматируем даты
                const formatDate = (dateString, userId) => {
                    if (dateString) {
                        const date = new Date(dateString);
                        return isNaN(date.getTime()) ? 'Неизвестно' :
                            date.toLocaleDateString('ru-RU', {
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric',
                                hour: '2-digit',
                                minute: '2-digit'
                            });
                    }

                    // Если dateString отсутствует, но есть userId - вычисляем по ID
                    if (userId) {
                        const creationDate = getCreationDate(userId);
                        return creationDate.toLocaleDateString('ru-RU', {
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric'
                        });
                    }

                    return 'Неизвестно';
                };

                // Обработка ролей
                const roles = Array.isArray(userData.roles) ? userData.roles : [];
                const sortedRoles = roles.sort((a, b) => (b.position || 0) - (a.position || 0));

                // Обработка предупреждений
                const warnings = Array.isArray(userData.warnings) ? userData.warnings : [];

                // Формируем HTML профиля
                profileContent.innerHTML = `
            <div class="profile-header">
                <div class="avatar-container">
                    <img src="${userData.avatar ?
                        `https://cdn.discordapp.com/avatars/${userData.id}/${userData.avatar}.png?size=256` :
                        'https://cdn.discordapp.com/embed/avatars/0.png'}" 
                         alt="${userData.username || 'User'}" 
                         class="profile-avatar">
                    ${userData.status ? `
                        <div class="status-badge" 
                             style="background-color: ${statusColors[userData.status] || '#747f8d'}"
                             title="${statusTexts[userData.status] || 'Offline'}">
                        </div>
                    ` : ''}
                </div>
                <div class="profile-info">
                    <h2>${userData.global_name || userData.username || 'Unknown User'}</h2>
                    ${userData.discriminator && userData.discriminator !== '0' ?
                        `<span class="user-tag">#${userData.discriminator}</span>` : ''}
                    <p class="profile-id">ID: ${userData.id}</p>
                    <div class="profile-badges">
                        ${userData.bot ? '<span class="badge bot-badge">BOT</span>' : ''}
                        ${userData.system ? '<span class="badge system-badge">SYSTEM</span>' : ''}
                    </div>
                </div>
            </div>
            
            <div class="profile-details">
                <div class="detail-section">
                    <h3>Основная информация</h3>
                    <div class="detail-row">
                        <span class="detail-label">Присоединился:</span>
                        <span class="detail-value">${formatDate(userData.joined_at)}</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Зарегистрирован:</span>
                        <span class="detail-value" title="Точная дата: ${getCreationDate(userData.id)?.toLocaleString('ru-RU') || 'Неизвестно'}">
                            ${userData.created_at ?
                        formatDate(userData.created_at) :
                        formatAccountAge(getCreationDate(userData.id))}
                        </span>
                    </div>
                </div>
                
                ${sortedRoles.length > 0 ? `
                <div class="detail-section">
                    <h3>Роли (${sortedRoles.length})</h3>
                    <div class="roles-list">
                        ${sortedRoles.map(role => `
                            <span class="role-badge" 
                                  style="background-color: #${(role.color || 0).toString(16).padStart(6, '0')}; 
                                  ${role.color === 0 ? 'background-color: #4f545c; color: white;' : ''}">
                                ${role.name || 'Unknown Role'}
                            </span>
                        `).join('')}
                    </div>
                </div>
                ` : ''}
            </div>
            
            <div class="profile-warnings">
                <h3>Предупреждения (${warnings.length})</h3>
                ${warnings.length > 0 ?
                        `<div class="warnings-container">
                        ${warnings.map(warning => `
                            <div class="warning-item">
                                <div class="warning-header">
                                    <span class="warning-date">
                                        ${formatDate(warning.created_at)}
                                    </span>
                                    ${warning.id ? `<span class="warning-id">#${warning.id}</span>` : ''}
                                </div>
                                <div class="warning-reason">
                                    <strong>Причина:</strong> ${warning.reason || 'Не указана'}
                                </div>
                                ${warning.moderator_name ? `
                                <div class="warning-moderator">
                                    <strong>Модератор:</strong> ${warning.moderator_name}
                                </div>
                                ` : ''}
                            </div>
                        `).join('')}
                    </div>` :
                        '<p class="no-warnings">Нет предупреждений</p>'}
            </div>
            
            <div class="profile-actions">
                <button class="btn warn-btn" onclick="showWarnForm('${userId}', '${userData.username || userData.global_name || 'User'}')">
                    Выдать предупреждение
                </button>
                <button class="btn ban-btn" onclick="showBanForm('${userId}', '${userData.username || userData.global_name || 'User'}')">
                    Забанить
                </button>
                <button class="btn time-btn" onclick="showTimeForm('${userId}', '${userData.username || userData.global_name || 'User'}')">
                    Отправить в Тайм-Аут
                </button>
            </div>
        `;
            } catch (error) {
                console.error('Error loading profile:', error);
                document.getElementById('profileContent').innerHTML = `
            <div class="error-loading">
                <i class="error-icon">!</i>
                <p>Ошибка при загрузке профиля</p>
                <p class="error-details">${error.message}</p>
                <button class="btn retry-btn" onclick="showUserProfile('${userId}')">
                    Попробовать снова
                </button>
            </div>
        `;
            }
        }

        // Функция показа формы выдачи предупреждения
        function showWarnForm(userId, username) {
            document.getElementById('profileContent').innerHTML += `
                <div class="warn-form" id="warnForm">
                    <h3>Выдать предупреждение ${username}</h3>
                    <form onsubmit="submitWarn(event, '${userId}')">
                        <textarea placeholder="Причина предупреждения" required></textarea>
                        <button type="submit" class="btn submit-btn">Подтвердить</button>
                        <button type="button" class="btn cancel-btn" onclick="document.getElementById('warnForm').remove()">Отмена</button>
                    </form>
                </div>
            `;
        }

        function handleOnlineUserClick(event) {
            const userCard = event.target.closest('.online-user-card');
            if (!userCard) return;

            // Получаем ID пользователя из data-атрибута (нужно добавить при создании карточки)
            const userId = userCard.dataset.userId;
            if (userId) {
                showUserProfile(userId);
            }
        }

        // Функция отправки предупреждения
        async function submitWarn(event, userId) {
            event.preventDefault();
            const reason = event.target.querySelector('textarea').value;

            try {
                const response = await fetch('/add-warning', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        userId: userId,
                        reason: reason
                    })
                });

                if (response.ok) {
                    alert('Предупреждение успешно выдано');
                    location.reload();
                } else {
                    throw new Error('Ошибка при выдаче предупреждения');
                }
            } catch (error) {
                console.error('Error submitting warning:', error);
                alert('Не удалось выдать предупреждение');
            }
        }

        // Закрытие модальных окон
        // Добавляем обработчики для визуальной обратной связи кнопок
        document.querySelectorAll('.btn, .theme-toggle, .user-dropdown-item, .warn-btn, .submit-btn, .cancel-btn').forEach(btn => {
            // Эффект при наведении
            btn.addEventListener('mouseenter', () => {
                btn.style.transform = 'translateY(-2px)';
                btn.style.boxShadow = '0 4px 8px rgba(0,0,0,0.2)';
            });

            // Эффект при уходе курсора
            btn.addEventListener('mouseleave', () => {
                btn.style.transform = '';
                btn.style.boxShadow = '';
            });

            // Эффект при нажатии
            btn.addEventListener('mousedown', () => {
                btn.style.transform = 'translateY(1px)';
                btn.style.boxShadow = '0 1px 2px rgba(0,0,0,0.2)';
            });

            // Восстановление после нажатия
            btn.addEventListener('mouseup', () => {
                btn.style.transform = 'translateY(-2px)';
                btn.style.boxShadow = '0 4px 8px rgba(0,0,0,0.2)';
            });
        });

        // Закрытие при клике вне окна
        window.addEventListener('click', (e) => {
            if (e.target.classList.contains('modal')) {
                e.target.style.display = 'none';
            }
        });

        // Обработка кнопки "Мой профиль"
        document.getElementById('viewProfile').addEventListener('click', async (e) => {
            e.preventDefault();
            await showUserProfile('<%= user.id %>');
        });

        async function loadOnlineUsers() {
            try {
                const response = await fetch('/api/online-members');
                const onlineUsers = await response.json();

                const container = document.getElementById('onlineUsers');
                container.innerHTML = '';

                if (onlineUsers.length === 0) {
                    container.innerHTML = '<p class="no-users">No online users</p>';
                    return;
                }

                onlineUsers.forEach(user => {
                    const statusColors = {
                        online: '#43b581',
                        idle: '#faa61a',
                        dnd: '#f04747',
                        offline: '#747f8d'
                    };

                    const statusTexts = {
                        online: 'Online',
                        idle: 'Idle',
                        dnd: 'Do Not Disturb',
                        offline: 'Offline'
                    };

                    const userCard = document.createElement('div');
                    userCard.className = 'online-user-card';
                    userCard.dataset.userId = user.id; // Добавляем ID пользователя
                    userCard.innerHTML = `
                <img src="${user.avatar ?
                            `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png?size=128` :
                            'https://cdn.discordapp.com/embed/avatars/0.png'}" 
                     alt="${user.username}" 
                     class="online-user-avatar"
                     style="border-color: ${statusColors[user.status] || '#747f8d'}">
                <span class="online-user-name">${user.username}</span>
                <span class="online-user-status" style="color: ${statusColors[user.status] || '#747f8d'}">
                    ${statusTexts[user.status] || 'Offline'}
                </span>
            `;
                    container.appendChild(userCard);
                });
            } catch (error) {
                console.error('Error loading online users:', error);
                document.getElementById('onlineUsers').innerHTML =
                    '<p class="error-message">Failed to load online users</p>';
            }
        }

        // Загружаем онлайн-пользователей при загрузке страницы
        document.addEventListener('DOMContentLoaded', loadOnlineUsers);

        // Обновляем каждые 30 секунд
        setInterval(loadOnlineUsers, 30000);

    </script>
</body>

</html>