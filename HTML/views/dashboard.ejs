<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Moderation Panel</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>Moderation Panel</h1>
            <div class="user-info">
                <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="User Avatar">
                <span><%= user.username %></span>
                <a href="/logout" class="logout-btn">Logout</a>
            </div>
        </header>

        <div class="stats">
            <div class="stat-card">
                <h3>Total Warnings</h3>
                <p><%= warnings.length %></p>
            </div>
            <div class="stat-card">
                <h3>Active Cases</h3>
                <p>0</p>
            </div>
        </div>

        <div class="warnings-table">
            <h2>Recent Warnings</h2>
            <table>
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Reason</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% warnings.forEach(warning => { %>
                        <tr>
                            <td>
                                <img src="https://cdn.discordapp.com/avatars/<%= warning.userId %>/avatar.png" alt="User Avatar" class="user-avatar">
                                <%= warning.username %>
                            </td>
                            <td><%= warning.reason %></td>
                            <td><%= warning.date %></td>
                            <td>
                                <a href="/remove-warning/<%= warning.id %>" class="btn remove-btn">Remove</a>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>