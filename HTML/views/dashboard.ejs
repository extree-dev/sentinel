<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Moderation Panel</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="light-theme">
    <div class="container">
        <header>
            <h1>Moderation Panel</h1>
            <div class="user-info">
                <div class="user-dropdown">
                    <div class="user-trigger" style="display: flex; align-items: center; cursor: pointer;">
                        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png"
                            alt="User Avatar">
                        <span style="margin: 0 10px;">
                            <%= user.username %>
                        </span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <path d="M6 9l6 6 6-6"></path>
                        </svg>
                    </div>
                    <div class="user-dropdown-content">
                        <a href="#" class="user-dropdown-item" id="viewProfile">Мой профиль</a>
                        <a href="#" class="user-dropdown-item" id="serverMembers">Участники сервера</a>
                        <a href="/logout" class="user-dropdown-item">Выйти</a>
                    </div>
                </div>
                <button class="theme-toggle" id="themeToggle">Dark Mode</button>
            </div>
        </header>

        <div id="mainContent">

            <div class="online-users-section">
                <h2>Online Members</h2>
                <div class="online-users-container" id="onlineUsers">
                    <!-- Список будет заполняться через JavaScript -->
                    <div class="loading-spinner"></div>
                </div>
            </div>

            <div class="stats">
                <div class="stat-card">
                    <h3>Total Warnings</h3>
                    <p>
                        <%= warnings.length %>
                    </p>
                </div>
                <div class="stat-card">
                    <h3>Active Cases</h3>
                    <p>0</p>
                </div>
            </div>

            <div class="warnings-table">
                <h2>Recent Warnings</h2>
                <table>
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Reason</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% warnings.forEach(warning=> { %>
                            <tr>
                                <td>
                                    <img src="https://cdn.discordapp.com/avatars/<%= warning.userId %>/avatar.png"
                                        alt="User Avatar" class="user-avatar">
                                    <%= warning.username %>
                                </td>
                                <td>
                                    <%= warning.reason %>
                                </td>
                                <td>
                                    <%= warning.date %>
                                </td>
                                <td>
                                    <a href="/remove-warning/<%= warning.id %>" class="btn remove-btn">Remove</a>
                                </td>
                            </tr>
                            <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Модальное окно для списка пользователей -->
    <div id="membersModal" class="modal">
        <div class="modal-content">
            <span class="close-modal" id="closeMembersModal">&times;</span>
            <h2>Участники сервера</h2>
            <div class="user-list-container" id="userList">
                <!-- Список пользователей будет загружен здесь -->
            </div>
        </div>
    </div>

    <!-- Модальное окно для профиля пользователя -->
    <div id="profileModal" class="modal">
        <div class="modal-content">
            <span class="close-modal" id="closeProfileModal">&times;</span>
            <div id="profileContent">
                <!-- Контент профиля будет загружен здесь -->
            </div>
        </div>
    </div>

    <script>

        function openModal(modalId) {
            document.getElementById(modalId).style.display = 'block';
        }

        function closeModal(modalId) {
            document.getElementById(modalId).style.display = 'none';
        }

        // Обработчики закрытия по крестику
        document.getElementById('closeMembersModal').addEventListener('click', function () {
            closeModal('membersModal');
        });

        document.getElementById('closeProfileModal').addEventListener('click', function () {
            closeModal('profileModal');
        });

        // Закрытие при клике вне окна
        window.addEventListener('click', function (event) {
            if (event.target.classList.contains('modal')) {
                closeModal(event.target.id);
            }
        });

        // Переключение темы
        const themeToggle = document.getElementById('themeToggle');
        const body = document.body;

        // Проверяем сохраненную тему
        const currentTheme = localStorage.getItem('theme') || 'light';
        body.classList.add(currentTheme + '-theme');
        updateButtonText();

        themeToggle.addEventListener('click', () => {
            // Добавляем класс для анимации
            body.classList.add('theme-transition');

            if (body.classList.contains('light-theme')) {
                body.classList.replace('light-theme', 'dark-theme');
                localStorage.setItem('theme', 'dark');
            } else {
                body.classList.replace('dark-theme', 'light-theme');
                localStorage.setItem('theme', 'light');
            }

            updateButtonText();

            // Удаляем класс после анимации
            setTimeout(() => {
                body.classList.remove('theme-transition');
            }, 600);
        });

        function updateButtonText() {
            themeToggle.textContent = body.classList.contains('dark-theme') ? 'Light Mode' : 'Dark Mode';
        }

        // Обработка выпадающего меню
        document.getElementById('serverMembers').addEventListener('click', async (e) => {
            e.preventDefault();
            openModal('membersModal');

            try {
                const response = await fetch('/api/server-members');
                const members = await response.json();

                const userList = document.getElementById('userList');
                userList.innerHTML = '';

                members.forEach(member => {
                    const userItem = document.createElement('div');
                    userItem.className = 'user-list-item';
                    userItem.dataset.userId = member.id;
                    userItem.innerHTML = `
                        <img src="${member.avatar ? `https://cdn.discordapp.com/avatars/${member.id}/${member.avatar}.png` : 'https://cdn.discordapp.com/embed/avatars/0.png'}" alt="${member.username}">
                        <span>${member.username}#${member.discriminator}</span>
                    `;
                    userList.appendChild(userItem);
                });
            } catch (error) {
                console.error('Error loading members:', error);
                alert('Не удалось загрузить список участников');
            }
        });

        // Обработчик клика по пользователю в списке
        document.addEventListener('click', async (e) => {
            if (e.target.closest('.user-list-item')) {
                const userId = e.target.closest('.user-list-item').dataset.userId;
                await showUserProfile(userId);
            }
        });

        // Функция показа профиля пользователя
        async function showUserProfile(userId) {
            try {
                closeModal('membersModal');
                openModal('profileModal');

                // Остальной код функции остается без изменений
                const response = await fetch(`/api/user-profile/${userId}`);
                const userData = await response.json();

                const profileContent = document.getElementById('profileContent');
                profileContent.innerHTML = `
                    <div class="profile-header">
                        <img src="${userData.avatar ? `https://cdn.discordapp.com/avatars/${userData.id}/${userData.avatar}.png?size=256` : 'https://cdn.discordapp.com/embed/avatars/0.png'}" 
                             alt="${userData.username}" class="profile-avatar">
                        <h2>${userData.username}#${userData.discriminator}</h2>
                        <p class="profile-id">ID: ${userData.id}</p>
                    </div>
                    
                    <div class="profile-details">
                        <div class="detail-row">
                            <span class="detail-label">Дата регистрации:</span>
                            <span class="detail-value">${new Date(userData.created_at).toLocaleString()}</span>
                        </div>
                        
                        <div class="detail-row">
                            <span class="detail-label">Присоединился:</span>
                            <span class="detail-value">${userData.joined_at ? new Date(userData.joined_at).toLocaleString() : 'Неизвестно'}</span>
                        </div>
                        
                        <div class="detail-row">
                            <span class="detail-label">Роли:</span>
                            <div class="roles-list">
                                ${userData.roles.map(role => `<span class="role-badge" style="background-color: #${role.color.toString(16).padStart(6, '0')}">${role.name}</span>`).join('')}
                            </div>
                        </div>
                    </div>
                    
                    <div class="profile-warnings">
                        <h3>Предупреждения</h3>
                        ${userData.warnings.length > 0 ?
                        `<table class="warnings-table">
                                <thead>
                                    <tr>
                                        <th>Причина</th>
                                        <th>Модератор</th>
                                        <th>Дата</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${userData.warnings.map(warning => `
                                        <tr>
                                            <td>${warning.reason}</td>
                                            <td>${warning.moderator_name}</td>
                                            <td>${new Date(warning.created_at).toLocaleString()}</td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>` :
                        '<p>Нет предупреждений</p>'}
                    </div>
                    
                    <div class="profile-actions">
                        <button class="btn warn-btn" onclick="showWarnForm('${userId}', '${userData.username}')">Выдать предупреждение</button>
                    </div>
                `;
            } catch (error) {
                console.error('Error loading profile:', error);
                alert('Не удалось загрузить профиль пользователя');
            }
        }

        // Функция показа формы выдачи предупреждения
        function showWarnForm(userId, username) {
            document.getElementById('profileContent').innerHTML += `
                <div class="warn-form" id="warnForm">
                    <h3>Выдать предупреждение ${username}</h3>
                    <form onsubmit="submitWarn(event, '${userId}')">
                        <textarea placeholder="Причина предупреждения" required></textarea>
                        <button type="submit" class="btn submit-btn">Подтвердить</button>
                        <button type="button" class="btn cancel-btn" onclick="document.getElementById('warnForm').remove()">Отмена</button>
                    </form>
                </div>
            `;
        }

        // Функция отправки предупреждения
        async function submitWarn(event, userId) {
            event.preventDefault();
            const reason = event.target.querySelector('textarea').value;

            try {
                const response = await fetch('/add-warning', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        userId: userId,
                        reason: reason
                    })
                });

                if (response.ok) {
                    alert('Предупреждение успешно выдано');
                    location.reload();
                } else {
                    throw new Error('Ошибка при выдаче предупреждения');
                }
            } catch (error) {
                console.error('Error submitting warning:', error);
                alert('Не удалось выдать предупреждение');
            }
        }

        // Закрытие модальных окон
        // Добавляем обработчики для визуальной обратной связи кнопок
        document.querySelectorAll('.btn, .theme-toggle, .user-dropdown-item, .warn-btn, .submit-btn, .cancel-btn').forEach(btn => {
            // Эффект при наведении
            btn.addEventListener('mouseenter', () => {
                btn.style.transform = 'translateY(-2px)';
                btn.style.boxShadow = '0 4px 8px rgba(0,0,0,0.2)';
            });

            // Эффект при уходе курсора
            btn.addEventListener('mouseleave', () => {
                btn.style.transform = '';
                btn.style.boxShadow = '';
            });

            // Эффект при нажатии
            btn.addEventListener('mousedown', () => {
                btn.style.transform = 'translateY(1px)';
                btn.style.boxShadow = '0 1px 2px rgba(0,0,0,0.2)';
            });

            // Восстановление после нажатия
            btn.addEventListener('mouseup', () => {
                btn.style.transform = 'translateY(-2px)';
                btn.style.boxShadow = '0 4px 8px rgba(0,0,0,0.2)';
            });
        });

        // Закрытие при клике вне окна
        window.addEventListener('click', (e) => {
            if (e.target.classList.contains('modal')) {
                e.target.style.display = 'none';
            }
        });

        // Обработка кнопки "Мой профиль"
        document.getElementById('viewProfile').addEventListener('click', async (e) => {
            e.preventDefault();
            await showUserProfile('<%= user.id %>');
        });

        async function loadOnlineUsers() {
            try {
                const response = await fetch('/api/online-members');
                const onlineUsers = await response.json();

                const container = document.getElementById('onlineUsers');
                container.innerHTML = '';

                if (onlineUsers.length === 0) {
                    container.innerHTML = '<p class="no-users">No online users</p>';
                    return;
                }

                onlineUsers.forEach(user => {
                    const statusColors = {
                        online: '#43b581',
                        idle: '#faa61a',
                        dnd: '#f04747',
                        offline: '#747f8d'
                    };

                    const statusTexts = {
                        online: 'Online',
                        idle: 'Idle',
                        dnd: 'Do Not Disturb',
                        offline: 'Offline'
                    };

                    const userCard = document.createElement('div');
                    userCard.className = 'online-user-card';
                    userCard.innerHTML = `
        <img src="${user.avatar ?
                            `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png?size=128` :
                            'https://cdn.discordapp.com/embed/avatars/0.png'}" 
             alt="${user.username}" 
             class="online-user-avatar"
             style="border-color: ${statusColors[user.status] || '#747f8d'}">
        <span class="online-user-name">${user.username}</span>
        <span class="online-user-status" style="color: ${statusColors[user.status] || '#747f8d'}">
            ${statusTexts[user.status] || 'Offline'}
        </span>
    `;
                    container.appendChild(userCard);
                });
            } catch (error) {
                console.error('Error loading online users:', error);
                document.getElementById('onlineUsers').innerHTML =
                    '<p class="error-message">Failed to load online users</p>';
            }
        }

        // Загружаем онлайн-пользователей при загрузке страницы
        document.addEventListener('DOMContentLoaded', loadOnlineUsers);

        // Обновляем каждые 30 секунд
        setInterval(loadOnlineUsers, 30000);

    </script>
</body>

</html>